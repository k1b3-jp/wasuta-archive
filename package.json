{
  "name": "wasuta-archive",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
		"postbuild": "node -e \"console.log('Dynamic sitemap routes are included in the Next.js build.')\"",
		"sitemap:generate": "next-sitemap",
    "start": "next start",
    "lint": "biome lint --write src",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "format": "biome format --write src",
		"check": "biome check --write src",
		"test:react-runtime": "node scripts/check-react-runtime.mjs",
		"test:api": "node scripts/check-api-contracts.mjs",
		"test:pwa": "node scripts/check-pwa.mjs",
		"test:navigation": "node scripts/check-navigation-contracts.mjs",
		"test:supabase": "supabase migration up --local && supabase db lint --local --level warning && supabase test db --local",
		"analyze": "ANALYZE=true next build"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.0.0",
    "@fortawesome/free-brands-svg-icons": "^7.0.0",
    "@fortawesome/free-regular-svg-icons": "^7.0.0",
    "@fortawesome/free-solid-svg-icons": "^7.0.0",
    "@fortawesome/react-fontawesome": "^3.0.0",
    "@headlessui/react": "^2.0.0",
    "@lottiefiles/react-lottie-player": "^3.5.3",
    "@next/bundle-analyzer": "^16.0.0",
    "@next/third-parties": "^16.0.0",
    "@radix-ui/react-dialog": "^1.1.6",
    "@supabase/supabase-js": "^2.39.1",
    "@vercel/analytics": "^2.0.0",
    "@vercel/og": "^1.0.0",
    "@vercel/speed-insights": "^2.0.0",
    "browser-image-compression": "^2.0.2",
    "clsx": "^2.1.1",
    "html-react-parser": "^6.0.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.0.0",
    "next": "16.3.1",
    "next-seo": "^7.0.0",
    "next-sitemap": "^4.2.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-leaflet": "^5.0.0",
    "react-share": "^5.1.0",
    "react-toastify": "^11.0.3",
    "sass": "^1.69.6",
    "string-width": "^8.0.0",
    "swiper": "^14.0.0",
    "swr": "^2.2.4",
    "tailwind-merge": "^3.0.2",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@storybook/addon-onboarding": "^10.0.0",
    "@storybook/nextjs": "^10.0.0",
    "@storybook/react": "^10.0.0",
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.0.1",
    "postcss": "^8",
    "storybook": "^10.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^7.0.0",
    "webpack": "^5.0.0"
  },
  "volta": {
    "node": "24.19.0",
    "yarn": "4.18.0"
  },
  "packageManager": "yarn@4.18.0"
}
